{
  "name": "solartournament",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cf:login": "wrangler login",
    "cf:create": "wrangler pages project create solartournament --production-branch master",
    "deploy": "npm run build && wrangler pages deploy --branch master",
    "deploy:preview": "npm run build && wrangler pages deploy --branch preview",
    "voice": "node tools/voice/render.ts"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "nipplejs": "^1.0.4",
    "three": "^0.186.1",
    "tone": "^15.1.22",
    "trystero": "^0.26.0"
  },
  "devDependencies": {
    "@echogarden/espeak-ng-emscripten": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  }
}
